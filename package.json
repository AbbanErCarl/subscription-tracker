{
  "name": "subscription-tracker",
  "version": "1.0.0",
  "description": "Composite featured backend combining subscription and user auth with rate limiting, API security, design, and best practices",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbbanErCarl/subscription-tracker.git"
  },
  "keywords": [
    "subscription",
    "tracker",
    "backend",
    "API",
    "security",
    "rate limiting",
    "user auth"
  ],
  "author": "@AbbanErCarl",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AbbanErCarl/subscription-tracker/issues"
  },
  "homepage": "https://github.com/AbbanErCarl/subscription-tracker#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
